# Auth.js (NextAuth v5) session secret — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-value

# Google OAuth client (Auth.js v5 auto-reads AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated emails granted the ADMIN role (first matching login becomes admin)
ADMIN_EMAILS=admin@example.com

# Public origin used to build MCP / Skill URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AES-256-GCM key for encrypting API-key secrets (required in production)
KEY_ENCRYPTION_SECRET=replace-with-a-different-long-random-value

# SQLite database file (default: worktrace-local.db)
LOCAL_DATABASE_PATH=worktrace-local.db
